<Window x:Class="LteRefSensTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="LTESenSearchREMusic2.2"
        Width="1200" Height="800" MinWidth="900" MinHeight="580"
        Background="#1E1E1E" Foreground="#D4D4D4"
        FontFamily="Segoe UI" FontSize="12"
        Icon="/app_music.ico">

    <Window.Resources>
        <SolidColorBrush x:Key="BgPanel"   Color="#252526"/>
        <SolidColorBrush x:Key="BgCell"    Color="#2D2D30"/>
        <SolidColorBrush x:Key="Accent"    Color="#569CD6"/>
        <SolidColorBrush x:Key="AccentGrn" Color="#4EC94E"/>
        <SolidColorBrush x:Key="AccentRed" Color="#F44747"/>
        <SolidColorBrush x:Key="FgSec"     Color="#9CDCFE"/>

        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Background"   Value="#3C3C3C"/>
            <Setter Property="Foreground"   Value="#D4D4D4"/>
            <Setter Property="BorderBrush"  Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="8,4"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnGo"   BasedOn="{StaticResource BtnBase}" TargetType="Button">
            <Setter Property="Background" Value="#0E6E20"/>
        </Style>
        <Style x:Key="BtnStop" BasedOn="{StaticResource BtnBase}" TargetType="Button">
            <Setter Property="Background" Value="#7A1E1E"/>
        </Style>
        <Style x:Key="BtnAcc"  BasedOn="{StaticResource BtnBase}" TargetType="Button">
            <Setter Property="Background" Value="#1C4A78"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background"    Value="#3C3C3C"/>
            <Setter Property="Foreground"    Value="#D4D4D4"/>
            <Setter Property="BorderBrush"   Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"       Value="4,2"/>
            <Setter Property="CaretBrush"    Value="#D4D4D4"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground"  Value="#9CDCFE"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="Padding"     Value="0,2,0,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D4D4D4"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background"           Value="#252526"/>
            <Setter Property="Foreground"           Value="#D4D4D4"/>
            <Setter Property="BorderBrush"          Value="#555"/>
            <Setter Property="GridLinesVisibility"  Value="All"/>
            <Setter Property="VerticalGridLinesBrush"   Value="#3C3C3C"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3C3C3C"/>
            <Setter Property="RowBackground"        Value="#252526"/>
            <Setter Property="AlternatingRowBackground" Value="#2D2D30"/>
            <Setter Property="SelectionMode"        Value="Single"/>
            <Setter Property="AutoGenerateColumns"  Value="False"/>
            <Setter Property="CanUserAddRows"       Value="False"/>
            <Setter Property="IsReadOnly"           Value="True"/>
            <Setter Property="ColumnHeaderHeight"   Value="28"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"  Value="#3C3C3C"/>
            <Setter Property="Foreground"  Value="#569CD6"/>
            <Setter Property="Padding"     Value="6,4"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#264F78"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E6D8E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D4D4D4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#264F78"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#3C3C3C"/>
        </Style>

        <!-- Dark ComboBox style -->
        <ControlTemplate x:Key="DarkComboBoxToggle" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" Background="#3C3C3C"
                BorderBrush="#569CD6" BorderThickness="1" CornerRadius="2"/>
                <Border Grid.Column="0" Background="Transparent" Margin="1"/>
                <Path Grid.Column="1" Fill="#9CDCFE" HorizontalAlignment="Center" VerticalAlignment="Center"
              Data="M 0 0 L 4 4 L 8 0 Z"/>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource DarkComboBoxToggle}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Focusable="False" ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="6,3,23,3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"
                       Background="Transparent" Foreground="White" CaretBrush="White"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="6,3,23,3" Focusable="True"
                       Style="{x:Null}"/>
                            <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                     Placement="Bottom" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#2D2D30" BorderBrush="#569CD6" BorderThickness="1"/>
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E6D8E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#264F78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="69.778"/>
            <ColumnDefinition Width="15.506"/>
            <ColumnDefinition Width="0"/>
            <ColumnDefinition Width="4.383"/>
            <ColumnDefinition Width="13.666"/>
            <ColumnDefinition Width="9.111"/>
            <ColumnDefinition Width="14.889"/>
            <ColumnDefinition Width="92.667"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="19*"/>
            <ColumnDefinition Width="273*"/>
        </Grid.ColumnDefinitions>

        <!-- ── LEFT PANEL ─────────────────────────────────────────── -->
        <Border Grid.Column="0" Background="{StaticResource BgPanel}"
            BorderBrush="#333" BorderThickness="0,0,1,0" Grid.ColumnSpan="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10">

                    <!-- CMW500 Connection -->
                    <TextBlock Text="CMW500 CONNECTION" Foreground="{StaticResource Accent}"
                     FontFamily="Segoe UI Semibold" FontSize="10" Margin="0,4,0,4"/>
                    <Label Content="IP Address"/>
                    <ComboBox Margin="0,2,0,2"
                    IsEditable="True" Text="{Binding CmwIpAddress, Mode=TwoWay}" SelectionChanged="ComboBox_SelectionChanged">
                        <ComboBoxItem Content="192.0.2.10"/>
                        <ComboBoxItem Content="192.0.2.10"/>
                    </ComboBox>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Connect" Style="{StaticResource BtnGo}"
                    Height="26" Margin="0,0,2,0"
                    Command="{Binding ConnectCommand}"/>
                        <Button Content="Disconnect" Style="{StaticResource BtnStop}"
                    Grid.Column="1" Height="26" Margin="2,0,0,0"
                    Command="{Binding DisconnectCommand}"/>
                    </Grid>

                    <!-- Status LED -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                     Fill="{Binding ConnectionColor}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ConnectionStatus}"
                       VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11"/>
                    </Grid>

                    <Separator Margin="0,4"/>

                    <!-- Test Parameters -->

                    <CheckBox IsChecked="{Binding UePowerEnabled, Mode=TwoWay}"
                              Content="功率测试 (UE TX Power)" FontSize="11" Margin="0,0,0,8"
                              ToolTip="勾选后在每个 TPC 阶段命中灵敏度时采样一次 UE TX Power；每点约多耗 4 秒。默认关闭"/>

                    <Label Content="UE COM 口"/>
                    <ComboBox Margin="0,2,0,8"
                              ItemsSource="{Binding ComPortOptions}"
                              SelectedItem="{Binding SelectedComPort, Mode=TwoWay}"
                              ToolTip="强制指定 UE 侧 USB CDC 串口，用于发送 pa play / reset / SIM AT+CFUN=1。选 自动 (Auto) 则按原逻辑枚举所有 USB CDC。"/>

                    <Label Content="初始 RefSens"/>
                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="📤 导出模板" Height="26" Margin="0,0,2,0"
                    Foreground="White" BorderThickness="0"
                    FontSize="11" Command="{Binding ExportTemplateCommand}"
                    ToolTip="导出CSV模板，包含所有Band和信道的RefSens列">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BtnBase}">
                                    <Setter Property="Background" Value="#1565C0"/>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="1" Content="📥 导入电平" Height="26" Margin="2,0,0,0"
                    Foreground="White" BorderThickness="0"
                    FontSize="11" Command="{Binding ImportTemplateCommand}"
                    ToolTip="导入填写好的CSV，设置各Band初始测试电平">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BtnBase}">
                                    <Setter Property="Background" Value="#2E7D32"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding RefSensImportStatus}"
                     Foreground="{Binding RefSensImportStatusColor}"
                     FontSize="10" Margin="0,0,0,8"/>

                    <CheckBox IsChecked="{Binding IsLossTableEnabled, Mode=TwoWay}"
                    Content="CMW500 线损表"
                    FontSize="12" Margin="0,0,0,2"
                    ToolTip="勾选启用线损表，取消勾选则不设置线损表"/>
                    <Grid Margin="0,2,0,0"
                IsEnabled="{Binding IsLossTableEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="📤 导出模板" Height="26" Margin="0,0,2,0"
                    Foreground="White" BorderThickness="0" FontSize="11"
                    Command="{Binding ExportLossTemplateCommand}"
                    ToolTip="导出线损表CSV模板（频率-损耗），填好后导入CMW500">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BtnBase}">
                                    <Setter Property="Background" Value="#6A1B9A"/>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="1" Content="📥 导入线损" Height="26" Margin="2,0,0,0"
                    Foreground="White" BorderThickness="0" FontSize="11"
                    Command="{Binding ImportLossTableCommand}"
                    ToolTip="导入填好的线损表CSV，上传至CMW500线损校正表并激活RF1C">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BtnBase}">
                                    <Setter Property="Background" Value="#00695C"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding LossTableStatus}"
                     Foreground="{Binding LossTableStatusColor}"
                     FontSize="10" Margin="0,2,0,8"/>

                    <!-- Hidden legacy fields kept for code compatibility -->
                    <TextBox x:Name="TxbSubframes" Text="3000" Visibility="Collapsed"/>
                    <TextBox x:Name="TxbULoss"      Text="8.0"    Visibility="Collapsed"/>
                    <TextBox x:Name="TxbDLoss"      Text="8.0"    Visibility="Collapsed"/>
                    <TextBox x:Name="TxbBlerThresh" Text="5.0"    Visibility="Collapsed"/>
                    <TextBox x:Name="TxbMeasMs"     Text="800"    Visibility="Collapsed"/>
                    <TextBox x:Name="TxbStartLevel" Text="-100.0" Visibility="Collapsed"/>
                    <TextBox x:Name="TxbMinLevel"   Text="-140.0" Visibility="Collapsed"/>

                    <Separator Margin="0,4"/>

                    <!-- Band Selection -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="BAND SELECTION" Foreground="{StaticResource Accent}"
                       FontFamily="Segoe UI Semibold" FontSize="10" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="All"  Width="30" Height="22"
                    Style="{StaticResource BtnBase}" Background="#444" FontSize="10"
                    Command="{Binding SelectAllBandsCommand}" Margin="0,0,2,0"/>
                        <Button Grid.Column="2" Content="None" Width="36" Height="22"
                    Style="{StaticResource BtnBase}" Background="#444" FontSize="10"
                    Command="{Binding SelectNoneBandsCommand}"/>
                    </Grid>
                    <TextBlock Text="─ FDD" Foreground="{StaticResource FgSec}" FontSize="10" Margin="0,2,0,3"/>
                    <WrapPanel Margin="2,0,0,4">
                        <ItemsControl ItemsSource="{Binding BandSelections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}"
                            IsChecked="{Binding IsSelected}"
                            ToolTip="{Binding ToolTip}"
                            Margin="0,1,6,1" FontSize="11">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Band.Mode}" Value="FDD">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                    <TextBlock Text="─ TDD" Foreground="{StaticResource FgSec}" FontSize="10" Margin="0,2,0,3"/>
                    <WrapPanel Margin="2,0,0,4">
                        <ItemsControl ItemsSource="{Binding BandSelections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}"
                            IsChecked="{Binding IsSelected}"
                            ToolTip="{Binding ToolTip}"
                            Margin="0,1,6,1" FontSize="11">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Band.Mode}" Value="TDD">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>

                    <Separator Margin="0,8"/>

                    <Separator Margin="0,4"/>

                    <!-- Actions -->
                    <Button Content="▶  Start (All Channels)"
                  Style="{StaticResource BtnGo}" Height="34" FontSize="13"
                  Command="{Binding StartTestCommand}" Margin="0,0,0,4"/>
                    <Button Content="▶  Mid Channel Only"
                  Style="{StaticResource BtnGo}" Height="28" FontSize="12"
                  Background="#1a6640"
                  Command="{Binding StartMidOnlyCommand}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Content="■  Stop" Style="{StaticResource BtnStop}"
                    Height="28" Command="{Binding StopTestCommand}" Margin="0,0,2,0"/>
                        <Button Grid.Column="1" Height="28" Margin="2,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BtnBase}">
                                    <Setter Property="Content" Value="⏸  Pause"/>
                                    <Setter Property="Command" Value="{Binding PauseCommand}"/>
                                    <Setter Property="Background" Value="#775500"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Content" Value="▶  Resume"/>
                                            <Setter Property="Command" Value="{Binding ResumeCommand}"/>
                                            <Setter Property="Background" Value="#0E6E20"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                    <Button Content="📄  Export Excel"
                  Style="{StaticResource BtnAcc}" Height="26"
                  Command="{Binding ExportResultsCommand}" Margin="0,0,0,4"/>

                    <Separator Margin="0,4"/>

                    <CheckBox IsChecked="{Binding IsScpiLogEnabled, Mode=TwoWay}"
                    Content="记录 SCPI 指令"
                    FontSize="11" Margin="0,0,0,4"
                    ToolTip="启用后记录所有发送/接收的 SCPI 指令，可导出为日志文件"/>
                    <Button Content="📋  导出 LOG"
                  Style="{StaticResource BtnAcc}" Height="24" FontSize="11"
                  Command="{Binding ExportLogCommand}" Margin="0,0,0,4"/>

                    <Button Content="🗑  Clear Log"
                  Style="{StaticResource BtnBase}" Background="#444" Height="22"
                  FontSize="10" Command="{Binding ClearLogCommand}"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="8" Width="4" HorizontalAlignment="Stretch"
                  Background="#333" ResizeBehavior="PreviousAndNext"/>

        <!-- ── RIGHT PANEL ────────────────────────────────────────── -->
        <Grid Grid.Column="9" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="180" MinHeight="100"/>
            </Grid.RowDefinitions>

            <!-- Status bar -->
            <Border Grid.Row="0" Background="#007ACC" Padding="10,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="White"
                     VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Progress: " Foreground="White" VerticalAlignment="Center"/>
                        <ProgressBar Width="160" Height="14"
                         Value="{Binding CurrentProgress}" Maximum="{Binding TotalProgress}"
                         Background="#1C4A78" Foreground="#4EC94E" Margin="4,0"/>
                        <TextBlock Text="{Binding ProgressText}" Foreground="White"
                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Results grid -->
            <DataGrid ItemsSource="{Binding Results}" Grid.Row="1" Margin="8,8,8,0" SelectionChanged="DataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Band"      Binding="{Binding BandDisplay}"  Width="45"/>
                    <DataGridTextColumn Header="Mode"      Binding="{Binding DuplexMode}"   Width="48"/>
                    <DataGridTextColumn Header="Channel"   Binding="{Binding Channel}"      Width="58"/>
                    <DataGridTextColumn Header="信道"    Binding="{Binding Earfcn}"       Width="42"/>
                    <DataGridTextColumn Header="DLRB"     Binding="{Binding DlRb}"         Width="48"/>
                    <DataGridTextColumn Header="ULRB"     Binding="{Binding UlRb}"         Width="48"/>

                    <!-- 音乐前 / 音乐中 — EPRE (RefSens) -->
                    <DataGridTextColumn Header="音乐前EPRE" Binding="{Binding RefSensBeforeStr}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{Binding SensColor}"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="音乐中EPRE" Binding="{Binding RefSensDuringStr}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{Binding SensColor}"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- UE TX Power at convergence (dBm) -->
                    <DataGridTextColumn Header="音乐前Power" Binding="{Binding UePowerBeforeStr}" Width="86">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="音乐中Power" Binding="{Binding UePowerDuringStr}" Width="84">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 音乐前 / 音乐中 — RSRP  显示格式 "-86.5 (54)" = RANGe 中点 dBm + 原始 index -->
                    <DataGridTextColumn Header="音乐前RSRP" Binding="{Binding RsrpBeforeStr}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{Binding SensColor}"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="音乐中RSRP" Binding="{Binding RsrpDuringStr}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{Binding SensColor}"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Diff (During − Before) -->
                    <DataGridTextColumn Header="音乐差值" Binding="{Binding RefSensDiffStr}" Width="72">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{Binding DiffColor}"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Probes"    Binding="{Binding SearchCount}"  Width="49"/>
                    <DataGridTextColumn Header="Result"    Binding="{Binding ResultText}"   Width="49">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{Binding ResultColor}"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Note"      Binding="{Binding Note}"         Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Splitter -->
            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                    Background="#333" ResizeBehavior="PreviousAndNext"/>

            <!-- Log -->
            <Border Grid.Row="3" Background="{StaticResource BgPanel}" Margin="8,0,8,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="SCPI LOG" Foreground="{StaticResource Accent}"
                     FontFamily="Segoe UI Semibold" FontSize="10"
                     Margin="8,4,0,2"/>
                    <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap"
                     Background="Transparent" BorderThickness="0"
                     FontFamily="Consolas" FontSize="11" Foreground="#D4D4D4"
                     Margin="8,0,8,8" VerticalAlignment="Top"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
