<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>LteRefSensTester</RootNamespace>
    <AssemblyName>LteRefSensTester</AssemblyName>
    <Platforms>x64</Platforms>
    <ApplicationIcon>app_music.ico</ApplicationIcon>
    <!-- 只保留中文简体 + 英文卫星程序集，砍掉法/德/日等无用本地化，显著减小发布体积 -->
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildTime</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString("o"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <!--
      app_music.ico 只需作为 WPF Resource（编译进程序集，XAML Icon="/app_music.ico" 走 pack URI 加载）
      + ApplicationIcon（写入 exe PE header，任务栏/资源管理器图标）。
      不再声明 <Content>：Content 语义要求文件在磁盘可访问，SingleFile 场景下需 IncludeAllContentForSelfExtract=true
      才能解压出来，与本项目的体积优化目标冲突。
    -->
    <Resource Include="app_music.ico" />
  </ItemGroup>
</Project>
